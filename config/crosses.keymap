/*
 * Crosses 54 keymap ported from semi1204/sofle-keyboard-config (codex/ctrl-rightclick-thumb, f4feaf1).
 * Sofle middle column, encoders, RGB and soft-off do not exist on Crosses.
 * Thumbs: L Option / Space-Cmd / Fn1-Esc, R B-Ctrl / Space-Fn2 / RCmd.
 */

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define AUTO_MOUSE 9

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
};

// Moving the right (pointer) trackball turns on AUTO_MOUSE for 500 ms after the last movement.
// Any key other than excluded-positions turns it off immediately.
&zip_temp_layer {
    require-prior-idle-ms = <300>;
    excluded-positions = <26 27 28 36 38 48 49>;
};

// Right ball = pointer: x1.75 (stock cpi 700 felt slow).
&trackball_central_listener {
    input-processors = <&zip_xy_scaler 7 4>, <&zip_temp_layer AUTO_MOUSE 500>, <&zip_ble_report_rate_limit>;
};

// Left ball = scroll: already /4 on the left half, x0.4 more here (stock felt too fast).
&trackball_peripheral_listener {
    input-processors = <&zip_scroll_scaler 2 5>;
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_54_layout; };

    behaviors {
        auto_option: auto_option {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_GUI>;
            display-name = "Auto Option / Win";
        };

        auto_command: auto_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LEFT_GUI>, <&kp LEFT_ALT>;
            display-name = "Auto Command / Alt";
        };

        // Windows host remaps raw RAlt/SC138 to Ctrl and LGUI to ordinary LAlt.
        auto_space: auto_space {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&mt RIGHT_GUI SPACE>, <&mt RIGHT_ALT SPACE>;
            display-name = "Auto Space / Cmd-Ctrl";
        };

        space_shift: space_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Space / Shift";
        };

        space_fn2: space_fn2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
            display-name = "Space / Fn2";
        };

        auto_right_command: auto_right_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp RIGHT_GUI>, <&kp RIGHT_ALT>;
            display-name = "Auto Right Command / Ctrl";
        };

        auto_right_alt: auto_right_alt {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp RIGHT_ALT>, <&kp LEFT_GUI>;
            display-name = "Auto Right Alt / Alt";
        };

        auto_b: auto_b {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&mt LCTRL B>, <&mt LEFT_ALT B>;
            display-name = "Auto B / Ctrl";
        };

        auto_back: auto_back {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LEFT_BRACKET)>, <&kp C_AC_BACK>;
            display-name = "Auto Back";
        };

        auto_forward: auto_forward {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(RIGHT_BRACKET)>, <&kp C_AC_FORWARD>;
            display-name = "Auto Forward";
        };

        // This Windows host maps raw Left Alt to Ctrl.
        auto_previous_tab: auto_previous_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(LEFT_BRACKET))>, <&kp LA(PG_UP)>;
            display-name = "Auto Previous Tab";
        };

        auto_next_tab: auto_next_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(RIGHT_BRACKET))>, <&kp LA(PG_DN)>;
            display-name = "Auto Next Tab";
        };

        auto_reopen_tab: auto_reopen_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(T))>, <&kp LA(LS(T))>;
            display-name = "Auto Reopen Tab";
        };

        auto_close_tab: auto_close_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(W)>, <&kp LA(W)>;
            display-name = "Auto Close Tab";
        };

        auto_address_bar: auto_address_bar {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(L)>, <&kp LA(L)>;
            display-name = "Auto Address Bar";
        };

        auto_line_start: auto_line_start {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LEFT)>, <&kp HOME>;
            display-name = "Auto Line Start";
        };

        auto_line_end: auto_line_end {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(RIGHT)>, <&kp END>;
            display-name = "Auto Line End";
        };

        auto_window_left: auto_window_left {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(LEFT_BRACKET)>, <&kp LC(LEFT)>;
            display-name = "Auto Window Left";
        };

        auto_window_right: auto_window_right {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(RIGHT_BRACKET)>, <&kp LC(RIGHT)>;
            display-name = "Auto Window Right";
        };

        auto_window_full: auto_window_full {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(BSLH)>, <&kp LC(UP)>;
            display-name = "Auto Window Full";
        };

        layer_click: layer_click {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
            display-name = "Layer Click";
        };

        hold_alt: hold_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
            bindings = <&auto_option>, <&kp>;
            display-name = "Hold Option / Tap Key";
        };

        // Balanced so Cmd+key works without waiting; recent typing always gives Space.
        space_cmd: space_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&auto_command>, <&kp>;
            display-name = "Hold Command / Tap Space";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Combos execute on the central, so these left-hand keys recover the right half.
        combo_left_bootloader {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&bootloader>;
            layers = <5 7>;
        };
        combo_left_reset {
            timeout-ms = <50>;
            key-positions = <39 40>;
            bindings = <&sys_reset>;
            layers = <5 7>;
        };
        // Keep Fn1 Tab management access reachable even with a saved runtime keymap.
        combo_fn1_manage {
            timeout-ms = <50>;
            key-positions = <12>;
            bindings = <&mo 5>;
            layers = <1>;
        };
        combo_sd_symbols {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&mo 3>;
            layers = <0>;
        };
        combo_jn_symbols {
            timeout-ms = <50>;
            key-positions = <31 42>;
            bindings = <&mo 4>;
            layers = <0>;
        };
        combo_kl_option {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mo 8>;
            layers = <0>;
        };
        combo_df_command {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp RIGHT_GUI>;
            layers = <0>;
        };
        combo_jk_delete_word {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&delete_word>;
            layers = <0>;
        };
        combo_jl_delete_line {
            timeout-ms = <50>;
            key-positions = <31 33>;
            bindings = <&delete_line>;
            layers = <0>;
        };
        combo_zx_caps_lock {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&kp CAPS>;
            layers = <0>;
        };
        combo_xc_escape {
            timeout-ms = <30>;
            key-positions = <38 39>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_paste_style {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&kp LG(LS(V))>;
            layers = <0>;
        };
        combo_qw_escape {
            timeout-ms = <30>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_comma_dot_enter {
            timeout-ms = <50>;
            key-positions = <44 45>;
            bindings = <&kp ENTER>;
            layers = <0>;
        };
    };

    macros {
        bt_channel_1: bt_channel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0 &out OUT_BLE>;
            display-name = "Bluetooth 1 (Mac)";
        };
        bt_channel_2: bt_channel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1 &out OUT_BLE>;
            display-name = "Bluetooth 2 (Windows)";
        };

        pair_parens: pair_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        pair_braces: pair_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };
        pair_brackets: pair_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        pair_double_quotes: pair_double_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };
        pair_single_quotes: pair_single_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp APOS &kp APOS &kp LEFT>;
        };
        pair_angles: pair_angles {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LT &kp GT &kp LEFT>;
        };
        delete_word: delete_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LA(LEFT) &kp LA(LS(RIGHT)) &kp BACKSPACE>;
        };
        delete_line: delete_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LG(LEFT) &kp LG(LEFT) &kp LS(DOWN) &kp BACKSPACE>;
        };
        symbol_arrow: symbol_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp EQUAL &kp GT>;
        };
        symbol_and: symbol_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp AMPERSAND &kp AMPERSAND>;
        };
        symbol_or: symbol_or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp PIPE &kp PIPE>;
        };

        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "LAYER0";
            bindings = <
&kp ESC              &kp N1               &kp N2               &kp N3               &kp N4               &kp N5                 &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &kp BSLH
&kp TAB              &kp Q                &kp W                &kp E                &kp R                &kp T                  &kp Y                &kp U                &kp I                &kp O                &kp P                &kp BACKSPACE
&kp CAPS             &kp A                &kp S                &kp D                &kp F                &kp G                  &kp H                &kp J                &kp K                &kp L                &kp SEMI             &kp ENTER
&kp LSHFT            &kp Z                &hold_alt 0 X        &kp C                &kp V                &kp B                  &kp N                &kp M                &hold_alt 0 COMMA    &kp DOT              &kp FSLH             &kp RIGHT_SHIFT
                                                               &auto_option         &space_cmd 0 SPACE   &lt 1 ESC             &auto_b              &space_fn2 2 SPACE   &auto_right_command
            >;
        };

        layer_1 {
            display-name = "LAYER1";
            bindings = <
&kp GRAVE        &kp F1           &kp F2           &kp F3           &kp F4           &kp F5             &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp DELETE
&mo 5            &kp GRAVE        &kp MINUS        &kp KP_PLUS      &kp STAR         &kp FSLH           &kp LPAR         &kp LBRC         &kp LBKT         &kp N7           &kp N8           &kp N9
&trans           &kp EXCL         &kp APOS         &none            &kp EQUAL        &kp DLLR           &kp RPAR         &kp RBRC         &kp RBKT         &kp N4           &kp N5           &kp N6
&trans           &kp TILDE        &kp PIPE         &kp HASH         &kp AMPS         &kp BSLH           &kp COLON        &kp COMMA        &kp DOT          &kp N1           &kp N2           &kp N3
                                                   &trans           &trans           &trans             &trans           &kp RIGHT_SHIFT  &trans
            >;
        };

        layer_2 {
            display-name = "LAYER2";
            bindings = <
&kp TILDE           &bt_channel_1       &bt_channel_2       &kp F3              &kp F4              &kp F5                &kp F6              &kp F7              &kp F8              &kp F9              &kp F10             &kp TAB
&kp TAB             &kp EXCL            &kp AT              &kp HASH            &kp DLLR            &kp TILDE             &auto_line_end      &kp LA(LEFT)        &kp UP              &kp LA(RIGHT)       &auto_previous_tab  &auto_next_tab
&kp CAPS            &kp STAR            &kp C_VOL_DN        &kp C_MUTE          &kp C_VOL_UP        &kp UNDER             &auto_line_start    &kp LEFT            &kp DOWN            &kp RIGHT           &auto_back          &auto_forward
&kp LSHFT           &kp LC(MINUS)       &kp LC(EQUAL)       &kp LC(N0)          &trans              &kp C_PLAY_PAUSE      &auto_reopen_tab    &auto_close_tab     &auto_address_bar   &none               &none               &none
                                                            &trans              &trans              &trans                &trans              &trans              &trans
            >;
        };

        layer_3 {
            display-name = "LAYER3";
            bindings = <
&trans               &trans               &trans               &trans               &trans               &trans                 &trans               &trans               &trans               &trans               &trans               &trans
&trans               &trans               &trans               &trans               &trans               &trans                 &trans               &pair_double_quotes  &pair_single_quotes  &kp MINUS            &kp PLUS             &trans
&trans               &kp EXCL             &trans               &trans               &kp QMARK            &trans                 &symbol_arrow        &pair_parens         &pair_braces         &pair_brackets       &kp EQUAL            &trans
&trans               &trans               &trans               &trans               &trans               &trans                 &symbol_and          &kp COLON            &symbol_or           &trans               &trans               &trans
                                                               &trans               &trans               &kp UNDER              &trans               &trans               &trans
            >;
        };

        layer_4 {
            display-name = "LAYER4";
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &kp AT        &kp HASH      &kp DLLR      &kp TILDE       &trans        &trans        &trans        &trans        &trans        &trans
&trans        &kp STAR      &kp GRAVE     &kp EXCL      &pair_angles  &kp UNDER       &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
                                          &trans        &trans        &trans          &trans        &trans        &trans
            >;
        };

        layer_5 {
            display-name = "MANAGE";
            bindings = <
&kp TILDE       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4      &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &trans
&trans          &bt BT_CLR      &bt BT_CLR_ALL  &trans          &trans          &trans            &trans          &trans          &kp F11         &kp F12         &kp UNDER       &kp PLUS
&trans          &out OUT_USB    &out OUT_BLE    &trans          &trans          &trans            &trans          &trans          &trans          &trans          &kp LBRC        &kp RBRC
&trans          &none           &none           &none           &none           &none             &none           &none           &sys_reset      &none           &bootloader     &trans
                                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        layer_6 {
            display-name = "MAC";
            bindings = <
&kp TILDE              &bt_channel_1          &bt_channel_2          &kp F3                 &kp F4                 &kp F5                   &kp F6                 &kp F7                 &kp F8                 &kp F9                 &kp F10                &trans
&mo 7                  &trans                 &kp C_VOL_DN           &kp C_VOL_UP           &kp C_MUTE             &trans                   &kp F11                &kp LA(LEFT)           &kp UP                 &kp LA(RIGHT)          &kp LG(LEFT_BRACKET)   &kp LG(RIGHT_BRACKET)
&trans                 &kp C_PLAY_PAUSE       &kp LA(LEFT_BRACKET)   &kp LA(BSLH)           &kp LA(RIGHT_BRACKET)  &trans                   &kp LG(LEFT_BRACKET)   &kp LEFT               &kp DOWN               &kp RIGHT              &kp LBRC               &kp RBRC
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &kp LG(MINUS)          &kp LG(EQUAL)          &kp LG(N0)             &trans                 &trans                 &trans
                                                                     &trans                 &kp LEFT_SHIFT         &trans                   &trans                 &trans                 &trans
            >;
        };

        layer_7 {
            display-name = "MAC MANAGE";
            bindings = <
&kp TILDE       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4      &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &trans
&trans          &bt BT_CLR      &bt BT_CLR_ALL  &trans          &trans          &trans            &trans          &trans          &kp F11         &kp F12         &kp UNDER       &kp PLUS
&trans          &out OUT_USB    &out OUT_BLE    &trans          &trans          &trans            &trans          &trans          &trans          &trans          &kp LBRC        &kp RBRC
&trans          &none           &none           &none           &none           &none             &none           &none           &sys_reset      &none           &bootloader     &trans
                                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        layer_8 {
            display-name = "WINDOW SPLIT";
            bindings = <
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &auto_window_left   &trans              &trans              &auto_window_right  &trans
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &auto_window_full   &trans              &trans              &trans              &trans
                                                            &trans              &trans              &trans                &trans              &trans              &trans
            >;
        };

        auto_mouse {
            display-name = "AUTO MOUSE";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
                                 &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };
    };
};
