                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp 0x00070050 &kp 0x00070051 &kp 0x00070052 &kp 0x0007004F &trans &trans
                &kp 0x000700E1 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
