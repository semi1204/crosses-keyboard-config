/*
 * Crosses 54 keymap ported from semi1204/sofle-keyboard-config (codex/ctrl-rightclick-thumb, f4feaf1).
 * Sofle middle column, encoders, RGB and soft-off do not exist on Crosses.
 * Thumbs: L Option / Space-Cmd / Fn1-Esc, R B-Ctrl / Space-Fn2 / RCmd.
 */

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define AUTO_MOUSE 9
#define SCROLL_MODE 10
#define ONE_HAND 11
#define MIRROR 12
#define ONE_NAV 13

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <150>;
};

// Moving the right (pointer) trackball turns on AUTO_MOUSE for 1000 ms after the last movement.
// Any key other than excluded-positions turns it off immediately.
&zip_temp_layer {
    require-prior-idle-ms = <300>;
    excluded-positions = <19 26 27 28 36 38 48 49>;
};

// Right ball = pointer: x1.75 (stock cpi 700 felt slow).
&trackball_central_listener {
    input-processors = <&zip_xy_scaler 7 4>, <&zip_temp_layer AUTO_MOUSE 1000>, <&zip_ble_report_rate_limit>;

    // Holding S or the left Option thumb on AUTO_MOUSE turns the right ball into a scroll wheel.
    scroll_mode {
        layers = <SCROLL_MODE>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_scroll_scaler 1 32>, <&zip_temp_layer AUTO_MOUSE 1000>, <&zip_ble_report_rate_limit>;
    };
};

// Left ball = scroll at 1/32 (stock 1/4 felt too fast).
&trackball_peripheral_listener {
    input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 32>, <&zip_ble_report_rate_limit>;

    // On Fn2 the left ball zooms (Cmd +/-) instead of scrolling.
    zoom {
        layers = <2>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 4>, <&zip_scroll_zoom>;
    };
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_54_layout; };

    zip_scroll_zoom: zip_scroll_zoom {
        compatible = "zmk,input-processor-scroll-keys";
        #input-processor-cells = <0>;
        code = <INPUT_REL_WHEEL>;
        threshold = <40>;
        bindings = <&auto_zoom_in>, <&auto_zoom_out>;
    };

    behaviors {
        auto_option: auto_option {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_GUI>;
            display-name = "Auto Option / Win";
        };

        auto_command: auto_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LEFT_GUI>, <&kp LEFT_ALT>;
            display-name = "Auto Command / Alt";
        };

        // Windows host remaps raw RAlt/SC138 to Ctrl and LGUI to ordinary LAlt.
        auto_space: auto_space {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&mt RIGHT_GUI SPACE>, <&mt RIGHT_ALT SPACE>;
            display-name = "Auto Space / Cmd-Ctrl";
        };

        space_shift: space_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Space / Shift";
        };

        space_fn2: space_fn2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
            display-name = "Space / Fn2";
        };

        auto_right_command: auto_right_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp RIGHT_GUI>, <&kp RIGHT_ALT>;
            display-name = "Auto Right Command / Ctrl";
        };

        auto_right_alt: auto_right_alt {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp RIGHT_ALT>, <&kp LEFT_GUI>;
            display-name = "Auto Right Alt / Alt";
        };

        auto_control: auto_control {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LCTRL>, <&kp LEFT_ALT>;
            display-name = "Auto Control";
        };

        auto_b: auto_b {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&mt LCTRL B>, <&mt LEFT_ALT B>;
            display-name = "Auto B / Ctrl";
        };

        auto_back: auto_back {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LEFT_BRACKET)>, <&kp C_AC_BACK>;
            display-name = "Auto Back";
        };

        auto_forward: auto_forward {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(RIGHT_BRACKET)>, <&kp C_AC_FORWARD>;
            display-name = "Auto Forward";
        };

        // This Windows host maps raw Left Alt to Ctrl.
        auto_previous_tab: auto_previous_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(LEFT_BRACKET))>, <&kp LA(PG_UP)>;
            display-name = "Auto Previous Tab";
        };

        auto_next_tab: auto_next_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(RIGHT_BRACKET))>, <&kp LA(PG_DN)>;
            display-name = "Auto Next Tab";
        };

        auto_reopen_tab: auto_reopen_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LS(T))>, <&kp LA(LS(T))>;
            display-name = "Auto Reopen Tab";
        };

        auto_close_tab: auto_close_tab {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(W)>, <&kp LA(W)>;
            display-name = "Auto Close Tab";
        };

        auto_zoom_in: auto_zoom_in {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(EQUAL)>, <&kp LA(EQUAL)>;
            display-name = "Auto Zoom In";
        };

        auto_zoom_out: auto_zoom_out {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(MINUS)>, <&kp LA(MINUS)>;
            display-name = "Auto Zoom Out";
        };

        auto_undo: auto_undo {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(Z)>, <&kp LA(Z)>;
            display-name = "Auto Undo";
        };

        auto_cut: auto_cut {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(X)>, <&kp LA(X)>;
            display-name = "Auto Cut";
        };

        auto_copy: auto_copy {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(C)>, <&kp LA(C)>;
            display-name = "Auto Copy";
        };

        auto_paste: auto_paste {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(V)>, <&kp LA(V)>;
            display-name = "Auto Paste";
        };

        // One-shot modifiers for ONE_NAV, same host mapping as auto_command/auto_option/auto_control.
        sticky_command: sticky_command {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&sk LEFT_GUI>, <&sk LEFT_ALT>;
            display-name = "Sticky Command";
        };

        sticky_option: sticky_option {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&sk LEFT_ALT>, <&sk LEFT_GUI>;
            display-name = "Sticky Option";
        };

        sticky_control: sticky_control {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&sk LCTRL>, <&sk LEFT_ALT>;
            display-name = "Sticky Control";
        };

        auto_line_start: auto_line_start {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(LEFT)>, <&kp HOME>;
            display-name = "Auto Line Start";
        };

        auto_line_end: auto_line_end {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LG(RIGHT)>, <&kp END>;
            display-name = "Auto Line End";
        };

        auto_window_left: auto_window_left {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(LEFT_BRACKET)>, <&kp LC(LEFT)>;
            display-name = "Auto Window Left";
        };

        auto_window_right: auto_window_right {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(RIGHT_BRACKET)>, <&kp LC(RIGHT)>;
            display-name = "Auto Window Right";
        };

        auto_window_full: auto_window_full {
            compatible = "zmk,behavior-profile-modifier";
            #binding-cells = <0>;
            windows-profile = <1>;
            bindings = <&kp LA(BSLH)>, <&kp LC(UP)>;
            display-name = "Auto Window Full";
        };

        layer_click: layer_click {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
            display-name = "Layer Click";
        };

        hold_ctrl: hold_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
            bindings = <&auto_control>, <&kp>;
            display-name = "Hold Control / Tap Key";
        };

        hold_right_alt: hold_right_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <350>;
            bindings = <&auto_right_alt>, <&kp>;
            display-name = "Hold Right Option / Tap Key";
        };

        // AUTO_MOUSE left thumb: tap = left click (quick re-taps for double/triple click),
        // hold past 150 ms = right-ball scroll (no Option).
        scroll_click: scroll_click {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&mkp>;
            display-name = "Hold Scroll / Tap Click";
        };

        // ONE_HAND Space: any key pressed while it is down is mirrored; alone it is Space.
        space_mirror: space_mirror {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            retro-tap;
            bindings = <&mo>, <&kp>;
            display-name = "Space / Mirror";
        };

        // Balanced so Cmd+key works without waiting; recent typing always gives Space.
        space_cmd: space_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&auto_command>, <&kp>;
            display-name = "Hold Command / Tap Space";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Combos execute on the central (left half); MANAGE's right-hand keys reach the right half.
        combo_left_bootloader {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&bootloader>;
            layers = <5 7>;
        };
        combo_left_reset {
            timeout-ms = <50>;
            key-positions = <39 40>;
            bindings = <&sys_reset>;
            layers = <5 7>;
        };
        // Keep Fn1 Tab management access reachable even with a saved runtime keymap.
        combo_fn1_manage {
            timeout-ms = <50>;
            key-positions = <12>;
            bindings = <&mo 5>;
            layers = <1>;
        };
        // Space + Fn1/Esc thumbs toggle one-handed mode.
        combo_one_hand {
            timeout-ms = <50>;
            key-positions = <49 50>;
            bindings = <&tog ONE_HAND>;
            layers = <0 ONE_HAND>;
        };
        combo_sd_symbols {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&mo 3>;
            layers = <0>;
        };
        combo_jn_symbols {
            timeout-ms = <50>;
            key-positions = <31 42>;
            bindings = <&mo 4>;
            layers = <0>;
        };
        combo_kl_option {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mo 8>;
            layers = <0>;
        };
        combo_df_command {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp RIGHT_GUI>;
            layers = <0 ONE_HAND>;
        };
        // Disabled: delete_word's LA() is Option only on the Mac profile; on the Windows profile
        // (Windows and Linux hosts) raw LAlt is Command, so it deleted the whole line.
        // J+K now reaches the host, whose own J+K chord (Karabiner / kanata) deletes the word.
        // combo_jk_delete_word {
        //     timeout-ms = <50>;
        //     key-positions = <31 32>;
        //     bindings = <&delete_word>;
        //     layers = <0>;
        // };
        // JK mirrored for one-handed mode: hold Space, then D+F (sends K+J to the host while disabled).
        // combo_mirror_delete_word {
        //     timeout-ms = <50>;
        //     key-positions = <27 28>;
        //     bindings = <&delete_word>;
        //     layers = <MIRROR>;
        // };
        combo_jl_delete_line {
            timeout-ms = <50>;
            key-positions = <31 33>;
            bindings = <&delete_line>;
            layers = <0>;
        };
        combo_zx_caps_lock {
            timeout-ms = <50>;
            key-positions = <37 38>;
            bindings = <&kp CAPS>;
            layers = <0>;
        };
        combo_xc_escape {
            timeout-ms = <30>;
            key-positions = <38 39>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_paste_style {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&kp LG(LS(V))>;
            layers = <0>;
        };
        combo_qw_escape {
            timeout-ms = <30>;
            key-positions = <13 14>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_comma_dot_enter {
            timeout-ms = <50>;
            key-positions = <44 45>;
            bindings = <&kp ENTER>;
            layers = <0>;
        };
    };

    macros {
        bt_channel_1: bt_channel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0 &out OUT_BLE>;
            display-name = "Bluetooth 1 (Mac)";
        };
        bt_channel_2: bt_channel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1 &out OUT_BLE>;
            display-name = "Bluetooth 2 (Windows)";
        };

        pair_parens: pair_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        pair_braces: pair_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };
        pair_brackets: pair_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        pair_double_quotes: pair_double_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
        };
        pair_single_quotes: pair_single_quotes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp APOS &kp APOS &kp LEFT>;
        };
        pair_angles: pair_angles {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LT &kp GT &kp LEFT>;
        };
        delete_word: delete_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LA(LEFT) &kp LA(LS(RIGHT)) &kp BACKSPACE>;
        };
        delete_line: delete_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp LG(LEFT) &kp LG(LEFT) &kp LS(DOWN) &kp BACKSPACE>;
        };
        symbol_arrow: symbol_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp EQUAL &kp GT>;
        };
        symbol_and: symbol_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp AMPERSAND &kp AMPERSAND>;
        };
        symbol_or: symbol_or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <40>;
            wait-ms = <40>;
            bindings = <&kp PIPE &kp PIPE>;
        };

        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "LAYER0";
            bindings = <
&kp ESC              &kp N1               &kp N2               &kp N3               &kp N4               &kp N5                 &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &kp BSLH
&kp TAB              &kp Q                &kp W                &kp E                &kp R                &hold_right_alt 0 T   &kp Y                &kp U                &kp I                &kp O                &kp P                &kp BACKSPACE
&kp CAPS             &kp A                &kp S                &kp D                &kp F                &kp G                  &kp H                &kp J                &kp K                &kp L                &kp SEMI             &kp ENTER
&kp LSHFT            &kp Z                &hold_ctrl 0 X       &kp C                &kp V                &kp B                  &kp N                &kp M                &hold_right_alt 0 COMMA &kp DOT              &kp FSLH             &kp RIGHT_SHIFT
                                                               &auto_option         &space_cmd 0 SPACE   &lt 1 ESC             &auto_b              &space_fn2 2 SPACE   &auto_right_command
            >;
        };

        layer_1 {
            display-name = "LAYER1";
            bindings = <
&kp GRAVE        &kp F1           &kp F2           &kp F3           &kp F4           &kp F5             &kp F6           &kp F7           &kp F8           &kp N7           &kp N8           &kp N9
&mo 5            &kp GRAVE        &kp MINUS        &kp KP_PLUS      &kp STAR         &kp FSLH           &kp LPAR         &kp LBRC         &kp LBKT         &kp N4           &kp N5           &kp N6
&trans           &kp EXCL         &kp APOS         &none            &kp EQUAL        &kp DLLR           &kp RPAR         &kp RBRC         &kp RBKT         &kp N1           &kp N2           &kp N3
&trans           &kp TILDE        &kp PIPE         &kp HASH         &kp AMPS         &kp BSLH           &kp COLON        &kp COMMA        &kp DOT          &kp N0           &trans           &kp DELETE
                                                   &trans           &trans           &trans             &trans           &kp RIGHT_SHIFT  &trans
            >;
        };

        layer_2 {
            display-name = "LAYER2";
            bindings = <
&kp TILDE           &bt_channel_1       &bt_channel_2       &kp F3              &kp F4              &kp F5                &kp F6              &kp F7              &kp F8              &kp F9              &kp F10             &kp TAB
&kp TAB             &kp EXCL            &kp AT              &kp HASH            &kp DLLR            &kp TILDE             &auto_line_end      &kp LA(LEFT)        &kp UP              &kp LA(RIGHT)       &auto_previous_tab  &auto_next_tab
&kp CAPS            &kp STAR            &kp C_VOL_DN        &kp C_MUTE          &kp C_VOL_UP        &kp UNDER             &auto_line_start    &kp LEFT            &kp DOWN            &kp RIGHT           &auto_back          &auto_forward
&kp LSHFT           &none               &none               &none               &trans              &kp C_PLAY_PAUSE      &auto_reopen_tab    &auto_close_tab     &auto_zoom_out      &auto_zoom_in       &none               &none
                                                            &trans              &kp LSHFT           &trans                &trans              &trans              &trans
            >;
        };

        layer_3 {
            display-name = "LAYER3";
            bindings = <
&trans               &trans               &trans               &trans               &trans               &trans                 &trans               &trans               &trans               &trans               &trans               &trans
&trans               &trans               &trans               &trans               &trans               &trans                 &trans               &pair_double_quotes  &pair_single_quotes  &kp MINUS            &kp PLUS             &trans
&trans               &kp EXCL             &trans               &trans               &kp QMARK            &trans                 &symbol_arrow        &pair_parens         &pair_braces         &pair_brackets       &kp EQUAL            &trans
&trans               &trans               &trans               &trans               &trans               &trans                 &symbol_and          &kp COLON            &symbol_or           &trans               &trans               &trans
                                                               &trans               &trans               &kp UNDER              &trans               &trans               &trans
            >;
        };

        layer_4 {
            display-name = "LAYER4";
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &kp AT        &kp HASH      &kp DLLR      &kp TILDE       &trans        &trans        &trans        &trans        &trans        &trans
&trans        &kp STAR      &kp GRAVE     &kp EXCL      &pair_angles  &kp UNDER       &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
                                          &trans        &trans        &trans          &trans        &trans        &trans
            >;
        };

        layer_5 {
            display-name = "MANAGE";
            bindings = <
&kp TILDE       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4      &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &trans
&trans          &bt BT_CLR      &bt BT_CLR_ALL  &trans          &trans          &trans            &trans          &trans          &kp F11         &kp F12         &kp UNDER       &kp PLUS
&trans          &out OUT_USB    &out OUT_BLE    &trans          &trans          &trans            &trans          &trans          &trans          &trans          &kp LBRC        &kp RBRC
&trans          &none           &none           &none           &none           &none             &none           &none           &sys_reset      &none           &bootloader     &trans
                                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        layer_6 {
            display-name = "MAC";
            bindings = <
&kp TILDE              &bt_channel_1          &bt_channel_2          &kp F3                 &kp F4                 &kp F5                   &kp F6                 &kp F7                 &kp F8                 &kp F9                 &kp F10                &trans
&mo 7                  &trans                 &kp C_VOL_DN           &kp C_VOL_UP           &kp C_MUTE             &trans                   &kp F11                &kp LA(LEFT)           &kp UP                 &kp LA(RIGHT)          &kp LG(LEFT_BRACKET)   &kp LG(RIGHT_BRACKET)
&trans                 &kp C_PLAY_PAUSE       &kp LA(LEFT_BRACKET)   &kp LA(BSLH)           &kp LA(RIGHT_BRACKET)  &trans                   &kp LG(LEFT_BRACKET)   &kp LEFT               &kp DOWN               &kp RIGHT              &kp LBRC               &kp RBRC
&trans                 &trans                 &trans                 &trans                 &trans                 &trans                   &kp LG(MINUS)          &kp LG(EQUAL)          &kp LG(N0)             &trans                 &trans                 &trans
                                                                     &trans                 &kp LEFT_SHIFT         &trans                   &trans                 &trans                 &trans
            >;
        };

        layer_7 {
            display-name = "MAC MANAGE";
            bindings = <
&kp TILDE       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4      &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &trans
&trans          &bt BT_CLR      &bt BT_CLR_ALL  &trans          &trans          &trans            &trans          &trans          &kp F11         &kp F12         &kp UNDER       &kp PLUS
&trans          &out OUT_USB    &out OUT_BLE    &trans          &trans          &trans            &trans          &trans          &trans          &trans          &kp LBRC        &kp RBRC
&trans          &none           &none           &none           &none           &none             &none           &none           &sys_reset      &none           &bootloader     &trans
                                                &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };

        layer_8 {
            display-name = "WINDOW SPLIT";
            bindings = <
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &auto_window_left   &trans              &trans              &auto_window_right  &trans
&trans              &trans              &trans              &trans              &trans              &trans                &trans              &auto_window_full   &trans              &trans              &trans              &trans
                                                            &trans              &trans              &trans                &trans              &trans              &trans
            >;
        };

        auto_mouse {
            display-name = "AUTO MOUSE";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &mkp LCLK  &trans     &trans     &trans     &trans
&trans     &trans     &layer_click SCROLL_MODE MCLK  &mkp RCLK  &mkp LCLK  &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
                                 &scroll_click SCROLL_MODE LCLK  &trans     &trans       &trans     &trans     &trans
            >;
        };

        scroll_mode {
            display-name = "SCROLL MODE";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
                                 &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        // Left half alone: Space thumb taps Space / holds MIRROR, Option thumb becomes Shift (D+F = Command),
        // Fn1/Esc thumb taps Esc / holds ONE_NAV.
        one_hand {
            display-name = "ONE HAND";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &trans
                                 &kp LSHFT  &space_mirror MIRROR SPACE  &lt ONE_NAV ESC  &trans     &trans     &trans
            >;
        };

        // Half-QWERTY: each left key types the right-hand key in the mirrored spot.
        mirror {
            display-name = "MIRROR";
            bindings = <
&kp BSLH       &kp N0         &kp N9         &kp N8         &kp N7         &kp N6           &trans     &trans     &trans     &trans     &trans     &trans
&kp BACKSPACE  &kp P          &kp O          &kp I          &kp U          &kp Y            &trans     &trans     &trans     &trans     &trans     &trans
&kp ENTER      &kp SEMI       &kp L          &kp K          &kp J          &kp H            &trans     &trans     &trans     &trans     &trans     &trans
&kp LSHFT      &kp FSLH       &kp DOT        &kp COMMA      &kp M          &kp N            &trans     &trans     &trans     &trans     &trans     &trans
                                             &trans         &trans         &trans           &trans     &trans     &trans
            >;
        };

        // ONE_HAND Fn1/Esc hold: arrows on ESDF, edit shortcuts on ZXCV, one-shot Ctrl/Option/Command on Q/T/B.
        one_nav {
            display-name = "ONE NAV";
            bindings = <
&trans           &trans           &trans           &trans           &trans           &trans             &trans     &trans     &trans     &trans     &trans     &trans
&trans           &sticky_control  &kp LA(LEFT)     &kp UP           &kp LA(RIGHT)    &sticky_option     &trans     &trans     &trans     &trans     &trans     &trans
&trans           &auto_line_start &kp LEFT         &kp DOWN         &kp RIGHT        &auto_line_end     &trans     &trans     &trans     &trans     &trans     &trans
&trans           &auto_undo       &auto_cut        &auto_copy       &auto_paste      &sticky_command    &trans     &trans     &trans     &trans     &trans     &trans
                                                   &trans           &trans           &trans             &trans     &trans     &trans
            >;
        };
    };
};
